# Credentials and local configuration
.env
.env.*
!.env.example
*.key

# Python environment and generated caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Generated output (rebuilt by anki.py)
6-output/
*.apkg

# Local-only content; never a substitute for reviewing staged changes
private/

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/

# Raw notes: local only (the repository is public)
# Pending notes stay local until processed; processed notes (2-raw/) are versioned,
# and so are the summary and review the agent leaves in the inbox.
1-inbox/*
!1-inbox/README.md
!1-inbox/review-*.md

