# Credentials and local configuration
.env
.env.*
!.env.example
*.key

# Python environment and generated caches
.venv/
.venv-audio/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Generated output (rebuilt by anki.py). The public export (dictionary.json) is versioned: consumers pin it by tag or
# commit. The compiled deck (.apkg) is not: it grows about 7 MB a batch and GitHub refuses files over 100 MB, so
# close-batch publishes it as the batch's GitHub release.
5-output/*
!5-output/dictionary.json

# Local-only content; never a substitute for reviewing staged changes
private/

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/

# Raw notes: local only (the repository is public)
# Pending notes stay local until processed; processed notes (1-inbox/history/) are versioned,
# and so is the review the agent leaves in the inbox.
1-inbox/*
!1-inbox/README.md
!1-inbox/review-*.md
!1-inbox/history/
